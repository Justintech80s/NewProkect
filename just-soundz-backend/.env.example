# Works immediately without an external key.
JUST_SOUNDZ_GENERATOR=built-in-procedural

# Existing Just Soundz frontend allowed to call the API.
JUST_SOUNDZ_ALLOWED_ORIGINS=https://just-soundz-ai-companion.justmarsh88.chatgpt.site

# Optional future GPU/model worker:
# JUST_SOUNDZ_GENERATOR=musicgen-jasco-worker
# JUST_SOUNDZ_GENERATOR=stable-audio-worker
# JUST_SOUNDZ_GENERATOR=http-worker
# JUST_SOUNDZ_WORKER_URL=https://your-approved-music-worker.example.com
# JUST_SOUNDZ_WORKER_TOKEN=replace-me

# Optional backend processing
JUST_SOUNDZ_ENABLE_DEMUCS=0
JUST_SOUNDZ_STEM_DIR=/tmp/just-soundz-stems

# Just Maker Music Brain
# PostgreSQL with pgvector extension enabled:
# JUST_MAKER_DATABASE_URL=postgresql://user:password@host:5432/justmaker

# Optional Neo4j relationship graph:
# JUST_MAKER_NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# JUST_MAKER_NEO4J_USER=neo4j
# JUST_MAKER_NEO4J_PASSWORD=replace-me

# Optional CLAP/audio-text embedding worker:
# JUST_MAKER_EMBEDDING_URL=https://your-embedding-worker.example.com
# JUST_MAKER_EMBEDDING_TOKEN=replace-me

# Phase 16: capability-aware GPU worker orchestration
# Primary full-conditioning GPU worker:
# JUST_SOUNDZ_PRIMARY_WORKER_URL=https://your-primary-gpu-worker.example.com
# JUST_SOUNDZ_PRIMARY_WORKER_TOKEN=replace-me
# JUST_SOUNDZ_PRIMARY_GPU_RHYTHM_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_HARMONY_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_INSTRUMENTATION_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_ARRANGEMENT_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_STEM_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_SAMPLE_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_NEGATIVE_PROMPT=true
# JUST_SOUNDZ_PRIMARY_GPU_MAX_DURATION_SECONDS=600

# Optional dedicated fallback workers:
# JUST_SOUNDZ_MUSICGEN_WORKER_URL=https://your-musicgen-worker.example.com
# JUST_SOUNDZ_MUSICGEN_WORKER_TOKEN=replace-me
# JUST_SOUNDZ_STABLE_WORKER_URL=https://your-stable-audio-worker.example.com
# JUST_SOUNDZ_STABLE_WORKER_TOKEN=replace-me

# Phase 17 durable jobs + artifact storage
# JUST_MAKER_SUPABASE_URL=https://your-project.supabase.co
# JUST_MAKER_SUPABASE_SERVICE_ROLE_KEY=replace-me
JUST_MAKER_ARTIFACT_BUCKET=just-maker-artifacts

# Phase 19 authenticated user ownership
# Use a client-safe Supabase publishable key for bearer-token validation.
# JUST_MAKER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Phase 20 usage quotas and abuse protection
JUST_MAKER_DAILY_JOB_LIMIT=20
JUST_MAKER_MONTHLY_SECONDS_LIMIT=7200
JUST_MAKER_CONCURRENT_JOB_LIMIT=2

# Phase 21 real GPU music worker
# Deploy just-soundz-backend/gpu-worker on a CUDA-capable host.
# The model ID is intentionally configurable so only appropriately licensed weights are used.
# JUST_MAKER_GPU_MODEL_ID=your-approved-music-model
# JUST_MAKER_GPU_BACKEND=transformers-musicgen
# JUST_MAKER_GPU_DEVICE=cuda
# JUST_MAKER_GPU_WORKER_TOKEN=replace-with-strong-secret
# JUST_MAKER_GPU_MAX_SECONDS=180
#
# Then connect the main backend:
# JUST_SOUNDZ_PRIMARY_WORKER_URL=https://your-gpu-worker.example.com
# JUST_SOUNDZ_PRIMARY_WORKER_TOKEN=replace-with-the-same-secret

# Phase 27 production hardening
JUST_MAKER_WORKER_TIMEOUT_SECONDS=600
JUST_MAKER_ARTIFACT_TIMEOUT_SECONDS=120
JUST_MAKER_CIRCUIT_FAILURE_THRESHOLD=3
JUST_MAKER_CIRCUIT_RESET_SECONDS=120
# Approximate infrastructure cost hook; tune to your GPU provider's actual rate.
JUST_MAKER_GPU_COST_PER_SECOND=0.0008

# Phase 37 evaluation-driven worker routing
# Historical quality only influences routing after this many evaluations.
JUST_MAKER_ROUTING_MIN_EVALUATIONS=5

# Phase 39 Supabase/Postgres + Kafka + GPU worker event backbone
# Kafka is optional until a real broker/cluster is connected.
# JUST_MAKER_KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9092
JUST_MAKER_KAFKA_CLIENT_ID=just-maker-backend
JUST_MAKER_KAFKA_JOB_TOPIC=justmaker.jobs
JUST_MAKER_KAFKA_GPU_REQUEST_TOPIC=justmaker.gpu.requests
JUST_MAKER_KAFKA_GPU_RESULT_TOPIC=justmaker.gpu.results
JUST_MAKER_KAFKA_RELAY_INTERVAL_SECONDS=2
JUST_MAKER_KAFKA_RELAY_BATCH_SIZE=100

# Managed Kafka authentication, when required:
# JUST_MAKER_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# JUST_MAKER_KAFKA_SASL_MECHANISM=PLAIN
# JUST_MAKER_KAFKA_SASL_USERNAME=replace-me
# JUST_MAKER_KAFKA_SASL_PASSWORD=replace-me

# GPU consumer group:
JUST_MAKER_KAFKA_GPU_GROUP_ID=just-maker-gpu-workers

# Phase 40 optional RocksDB worker-side hot cache.
# Install requirements-rocksdb.txt on backend/GPU hosts where local caching is desired.
JUST_MAKER_ROCKSDB_ENABLED=0
JUST_MAKER_ROCKSDB_PATH=/tmp/just-maker-rocksdb
JUST_MAKER_ROCKSDB_TTL_SECONDS=900

# Phase 41 distributed RocksDB cache coherence
JUST_MAKER_KAFKA_CACHE_TOPIC=justmaker.cache
# Use a host-unique group when every node must receive invalidation events.
# JUST_MAKER_KAFKA_CACHE_GROUP_ID=just-maker-cache-hostname
# JUST_MAKER_KAFKA_GPU_CACHE_GROUP_ID=just-maker-gpu-cache-hostname

# Phase 43 adaptive RocksDB TTL tuning
JUST_MAKER_ADAPTIVE_CACHE_TTL=1
JUST_MAKER_CACHE_MIN_TTL_SECONDS=120
JUST_MAKER_CACHE_MAX_TTL_SECONDS=3600

# Phase 44 optional Rust DSP acceleration
# Build/install with: pip install -r requirements-rustdsp.txt && maturin develop --release -m rust-dsp/Cargo.toml
JUST_MAKER_RUST_DSP_ENABLED=1

# Phase 45 real Kafka runtime readiness
JUST_MAKER_KAFKA_ADMIN_CLIENT_ID=just-maker-admin
JUST_MAKER_KAFKA_DEFAULT_PARTITIONS=6
# Local single-broker development uses 1. Use 3+ in a production multi-broker cluster.
JUST_MAKER_KAFKA_REPLICATION_FACTOR=1
JUST_MAKER_KAFKA_DLQ_TOPIC=justmaker.dead-letter

# Phase 46 RocksDB runtime enablement
# Use persistent local SSD/NVMe on real backend/GPU hosts.
# JUST_MAKER_ROCKSDB_PATH=/var/lib/just-maker/rocksdb
JUST_MAKER_ROCKSDB_MIN_FREE_BYTES=2147483648

# Phase 47 multi-model GPU ensemble
# Format: name|kind|url_env|token_env|priority;...
# JUST_MAKER_ENSEMBLE_WORKERS=hiphop-gpu|http-worker|HIPHOP_GPU_URL|HIPHOP_GPU_TOKEN|12;cinematic-gpu|stable-audio-worker|CINEMATIC_GPU_URL|CINEMATIC_GPU_TOKEN|14
# HIPHOP_GPU_URL=https://your-licensed-hiphop-worker.example.com
# HIPHOP_GPU_TOKEN=replace-me
# CINEMATIC_GPU_URL=https://your-licensed-cinematic-worker.example.com
# CINEMATIC_GPU_TOKEN=replace-me
# JUST_MAKER_HIPHOP_GPU_GENRES=hip-hop,boom-bap,trap
# JUST_MAKER_CINEMATIC_GPU_GENRES=cinematic,orchestral,ambient

# Phase 48 large-scale Music Brain ingestion
JUST_MAKER_DATASET_CHECKPOINT_EVERY=100
JUST_MAKER_DATASET_MAX_ERROR_SAMPLES=25

# Phase 49 audio embedding intelligence
# Embedding worker should expose /embed/text and /embed/audio with compatible
# 512-dimensional text/audio embeddings (for example, a licensed CLAP service).
# JUST_MAKER_EMBEDDING_URL=https://your-audio-embedding-worker.example.com
# JUST_MAKER_EMBEDDING_TOKEN=replace-me
