# Works immediately without an external key.
JUST_SOUNDZ_GENERATOR=built-in-procedural

# Existing Just Soundz frontend allowed to call the API.
JUST_SOUNDZ_ALLOWED_ORIGINS=https://just-soundz-ai-companion.justmarsh88.chatgpt.site

# Optional future GPU/model worker:
# JUST_SOUNDZ_GENERATOR=musicgen-jasco-worker
# JUST_SOUNDZ_GENERATOR=stable-audio-worker
# JUST_SOUNDZ_GENERATOR=http-worker
# JUST_SOUNDZ_WORKER_URL=https://your-approved-music-worker.example.com
# JUST_SOUNDZ_WORKER_TOKEN=replace-me

# Optional backend processing
JUST_SOUNDZ_ENABLE_DEMUCS=0
JUST_SOUNDZ_STEM_DIR=/tmp/just-soundz-stems

# Just Maker Music Brain
# PostgreSQL with pgvector extension enabled:
# JUST_MAKER_DATABASE_URL=postgresql://user:password@host:5432/justmaker

# Optional Neo4j relationship graph:
# JUST_MAKER_NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# JUST_MAKER_NEO4J_USER=neo4j
# JUST_MAKER_NEO4J_PASSWORD=replace-me

# Optional CLAP/audio-text embedding worker:
# JUST_MAKER_EMBEDDING_URL=https://your-embedding-worker.example.com
# JUST_MAKER_EMBEDDING_TOKEN=replace-me

# Phase 16: capability-aware GPU worker orchestration
# Primary full-conditioning GPU worker:
# JUST_SOUNDZ_PRIMARY_WORKER_URL=https://your-primary-gpu-worker.example.com
# JUST_SOUNDZ_PRIMARY_WORKER_TOKEN=replace-me
# JUST_SOUNDZ_PRIMARY_GPU_RHYTHM_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_HARMONY_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_INSTRUMENTATION_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_ARRANGEMENT_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_STEM_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_SAMPLE_CONDITIONING=true
# JUST_SOUNDZ_PRIMARY_GPU_NEGATIVE_PROMPT=true
# JUST_SOUNDZ_PRIMARY_GPU_MAX_DURATION_SECONDS=600

# Optional dedicated fallback workers:
# JUST_SOUNDZ_MUSICGEN_WORKER_URL=https://your-musicgen-worker.example.com
# JUST_SOUNDZ_MUSICGEN_WORKER_TOKEN=replace-me
# JUST_SOUNDZ_STABLE_WORKER_URL=https://your-stable-audio-worker.example.com
# JUST_SOUNDZ_STABLE_WORKER_TOKEN=replace-me

# Phase 17 durable jobs + artifact storage
# JUST_MAKER_SUPABASE_URL=https://your-project.supabase.co
# JUST_MAKER_SUPABASE_SERVICE_ROLE_KEY=replace-me
JUST_MAKER_ARTIFACT_BUCKET=just-maker-artifacts

# Phase 19 authenticated user ownership
# Use a client-safe Supabase publishable key for bearer-token validation.
# JUST_MAKER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Phase 20 usage quotas and abuse protection
JUST_MAKER_DAILY_JOB_LIMIT=20
JUST_MAKER_MONTHLY_SECONDS_LIMIT=7200
JUST_MAKER_CONCURRENT_JOB_LIMIT=2

# Phase 21 real GPU music worker
# Deploy just-soundz-backend/gpu-worker on a CUDA-capable host.
# The model ID is intentionally configurable so only appropriately licensed weights are used.
# JUST_MAKER_GPU_MODEL_ID=your-approved-music-model
# JUST_MAKER_GPU_BACKEND=transformers-musicgen
# JUST_MAKER_GPU_DEVICE=cuda
# JUST_MAKER_GPU_WORKER_TOKEN=replace-with-strong-secret
# JUST_MAKER_GPU_MAX_SECONDS=180
#
# Then connect the main backend:
# JUST_SOUNDZ_PRIMARY_WORKER_URL=https://your-gpu-worker.example.com
# JUST_SOUNDZ_PRIMARY_WORKER_TOKEN=replace-with-the-same-secret
